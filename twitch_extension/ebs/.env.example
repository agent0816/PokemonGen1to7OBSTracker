# --- Server ---
PORT=8081
HOST=0.0.0.0
LOG_LEVEL=info

# --- Twitch Extension ---
# Aus Twitch Developer Console, Extension → Übersicht.
TWITCH_EXTENSION_CLIENT_ID=
# Extension-Secret ist Base64-kodiert; wird beim Start dekodiert und als HS256-Key benutzt.
TWITCH_EXTENSION_SECRET_BASE64=
# Owner-Twitch-User-ID des Extension-Besitzers (für Publish-JWT `user_id`).
TWITCH_EXTENSION_OWNER_ID=

# --- Ingest-Auth (Tracker/Headless-Server → EBS) ---
# Beliebiger langer Zufallswert. Wird als `Authorization: Bearer <secret>` erwartet.
INGEST_SHARED_SECRET=

# --- PubSub ---
# Auf true setzen, um Publishes NICHT wirklich an Twitch zu schicken (lokales Testen).
PUBSUB_DRY_RUN=true

# --- CORS ---
# Kommagetrennte Liste zusätzlicher erlaubter Origins (Dev-Rig etc.).
ALLOWED_ORIGINS=https://localhost.rig.twitch.tv:8080
